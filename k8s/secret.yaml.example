# Copy to secret.yaml and fill in base64 values. Do not commit secret.yaml.
# Generate base64: echo -n "your-value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: tot-debugging-secret
  namespace: tot-debugging
  labels:
    app: tot-debugging
type: Opaque
data:
  JWT_SECRET: ""          # e.g. echo -n "your-jwt-secret-32chars" | base64
  OPENAI_API_KEY: ""     # e.g. echo -n "sk-..." | base64
  GROQ_API_KEY: ""       # e.g. echo -n "gsk_..." | base64 (optional if using Groq)
  MONGODB_URI: ""         # e.g. echo -n "mongodb+srv://..." | base64
